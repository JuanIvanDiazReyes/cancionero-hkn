  {
   "id": "001-cielito-lindo",
   "number": 1,
   "title": "CIELITO LINDO",
   "album": "EJEMPLOS",
   "capo": null,
   "chordDefinitions": {},
   "blocks": [
    {
     "label": null,
     "lines": [
      {
       "type": "instrumental",
       "label": "INTRO",
       "chords": [
        "C",
        "G7",
        "C"
       ],
       "text": "INTRO: C G7 C"
      },
      {
       "type": "lyric",
       "text": "De la Sierra Morena, cielito lindo, vienen bajando,",
       "chords": [
        {
         "pos": 6,
         "chord": "C"
        },
        {
         "pos": 29,
         "chord": "G7"
        },
        {
         "pos": 45,
         "chord": "C"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "un par de ojitos negros, cielito lindo, de contrabando.",
       "chords": [
        {
         "pos": 17,
         "chord": "C7"
        },
        {
         "pos": 33,
         "chord": "F"
        },
        {
         "pos": 49,
         "chord": "G7"
        }
       ]
      }
     ]
    },
    {
     "label": "CORO",
     "lines": [
      {
       "type": "lyric",
       "text": "Ay, ay, ay, ay, canta y no llores,",
       "chords": [
        {
         "pos": 0,
         "chord": "G7"
        },
        {
         "pos": 12,
         "chord": "C"
        },
        {
         "pos": 27,
         "chord": "F"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "porque cantando se alegran, cielito lindo, los corazones.",
       "chords": [
        {
         "pos": 10,
         "chord": "G7"
        },
        {
         "pos": 36,
         "chord": "C"
        },
        {
         "pos": 51,
         "chord": "G7"
        },
        {
         "pos": 53,
         "chord": "C"
        }
       ]
      }
     ]
    },
    {
     "label": null,
     "lines": [
      {
       "type": "lyric",
       "text": "Pájaro que abandona, cielito lindo, su primer nido,",
       "chords": [
        {
         "pos": 12,
         "chord": "C"
        },
        {
         "pos": 29,
         "chord": "G7"
        },
        {
         "pos": 46,
         "chord": "C"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "si lo encuentra ocupado, cielito lindo, bien merecido.",
       "chords": [
        {
         "pos": 8,
         "chord": "C7"
        },
        {
         "pos": 33,
         "chord": "F"
        },
        {
         "pos": 49,
         "chord": "G7"
        }
       ]
      }
     ]
    }
   ]
