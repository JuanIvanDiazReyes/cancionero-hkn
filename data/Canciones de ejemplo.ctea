  {
   "id": "003-las-mananitas",
   "number": 3,
   "title": "LAS MAÑANITAS",
   "album": "EJEMPLOS",
   "capo": null,
   "chordDefinitions": {},
   "blocks": [
    {
     "label": null,
     "lines": [
      {
       "type": "lyric",
       "text": "Estas son las mañanitas que cantaba el rey David,",
       "chords": [
        {
         "pos": 16,
         "chord": "D"
        },
        {
         "pos": 45,
         "chord": "A7"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "hoy por ser día de tu santo te las cantamos aquí.",
       "chords": [
        {
         "pos": 22,
         "chord": "A7"
        },
        {
         "pos": 45,
         "chord": "D"
        }
       ]
      }
     ]
    },
    {
     "label": "CORO",
     "lines": [
      {
       "type": "lyric",
       "text": "Despierta, mi bien, despierta, mira que ya amaneció,",
       "chords": [
        {
         "pos": 3,
         "chord": "D"
        },
        {
         "pos": 23,
         "chord": "A7"
        },
        {
         "pos": 46,
         "chord": "D"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "ya los pajarillos cantan, la luna ya se metió.",
       "chords": [
        {
         "pos": 18,
         "chord": "A7"
        },
        {
         "pos": 42,
         "chord": "D"
        }
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "004-de-colores",
   "number": 4,
   "title": "DE COLORES",
   "album": "EJEMPLOS",
   "capo": 2,
   "chordDefinitions": {},
   "blocks": [
    {
     "label": null,
     "lines": [
      {
       "type": "lyric",
       "text": "De colores, de colores se visten los campos en la primavera.",
       "chords": [
        {
         "pos": 5,
         "chord": "E"
        },
        {
         "pos": 55,
         "chord": "B7"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "De colores, de colores son los pajarillos que vienen de afuera.",
       "chords": [
        {
         "pos": 57,
         "chord": "E"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "De colores, de colores es el arco iris que vemos lucir.",
       "chords": [
        {
         "pos": 5,
         "chord": "E7"
        },
        {
         "pos": 51,
         "chord": "A"
        }
       ]
      }
     ]
    },
    {
     "label": "CORO",
     "lines": [
      {
       "type": "lyric",
       "text": "Y por eso los grandes amores de muchos colores me gustan a mí,",
       "chords": [
        {
         "pos": 6,
         "chord": "B7"
        },
        {
         "pos": 41,
         "chord": "E"
        },
        {
         "pos": 59,
         "chord": "B7"
        }
       ]
      },
      {
       "type": "lyric",
       "text": "y por eso los grandes amores de muchos colores me gustan a mí.",
       "chords": [
        {
         "pos": 41,
         "chord": "E"
        }
       ]
      }
     ]
    }
   ]
  },
